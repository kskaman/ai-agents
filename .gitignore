# Secrets - never commit API keys
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Claude Code: personal settings stay local; shared .claude/ config is committed
.claude/settings.local.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Archify check receipts (regenerated on every finalize)
docs/*.finalize.json
docs/*.finalize-summary.json
docs/*.browser-check.json
docs/*.delivery.json
